[Unit]
Description=Exiled Exchange 2 — Hyprland overlay host
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/ee2-hyprland
Restart=on-failure
RestartSec=2

# The WebView loads the renderer from our own loopback server (server.rs
# binds 127.0.0.1:0). If this user session ever has http_proxy/https_proxy set
# (some setups export it globally), WebKit's network stack routes those
# loopback requests through the proxy too and they fail — the renderer never
# mounts (HYPRLAND-NOTES.md §10). Outbound trade-site requests (proxy.rs,
# reqwest) still use the proxy. Both spellings because different consumers
# check different cases. The binary also appends these entries itself at
# startup (main.rs, `exempt_loopback_from_proxy`), so a direct launch works
# without this unit; the lines here are belt-and-braces.
Environment=NO_PROXY=127.0.0.1,localhost
Environment=no_proxy=127.0.0.1,localhost

# Deliberately no [Install] section.
#
# This service's lifecycle is tied to the game process, not to login: it is
# started/stopped by `ee2-hyprland-wrap` around the PoE2 process (see that
# script), or manually via `systemctl --user start/stop ee2-hyprland` when
# launched from the applications menu (ee2-hyprland.desktop). Without
# [Install], `systemctl --user enable ee2-hyprland` has nothing to link
# against and refuses outright ("has no installation config") instead of
# silently doing nothing useful — that's intentional: it stops this from
# ever getting wired into session autostart by a routine `enable`, since an
# overlay sitting in every session regardless of whether PoE2 is even
# running is exactly the always-on-in-the-background footprint this fork's
# lifecycle design exists to avoid. If autostart is ever
# wanted, add [Install] WantedBy=graphical-session.target explicitly rather
# than assuming this omission was an oversight.
